# colcon build artifacts - match at ANY depth, not just top-level ros2_ws/
**/build/
**/install/
**/log/

# Gazebo's full stock model library - regenerated by setup_gazebo_worlds.sh
# / fetched fresh via gz fuel download (see Dockerfile)
**/simulation_models/temp_models/

# Pretrained model weights - re-downloadable (see README)
*.pt

# Rosbag recordings - record fresh as needed during development,
# don't accumulate test recordings in git history. Promote a real
# evaluation run to git (or Git LFS / external storage) deliberately,
# not by default.
*.mcap
*.db3
*.bag

# Debug / generated artifacts from past debugging sessions
build_error.txt
frames_*.gv
frames_*.pdf

# Python
__pycache__/
*.pyc
*.egg-info/

# Gazebo runtime cache (bind-mounted from host, not part of repo)
.gz/

# IDE / OS
.vscode/
.DS_Store
*.swp
output.log
ros2_ws/.claude/
# CLAUDE.md lives at repo root now
ros2_ws/debug_notes_2026-06-24.md
# Personal thesis writing notes - not source code
notes/

*.log
ros2_ws/bags/
ros2_ws/*.png
ros2_ws/*.jpg
ros2_ws/eval_plots/
ros2_ws/analysis/eval_plots/
ros2_ws/logs/

# Trial run logs and evaluation outputs - regenerate per-run, don't
# accumulate test-run artifacts in git history (same rationale as
# rosbag recordings above)
**/eval_logs/
**/eval_plots/
*_trial.log

ros2_ws/models/*.pt
ros2_ws/models/yolov8n_openvino_model/
ros2_ws/yolov8n.pt
# OpenVINO model files — re-exportable from weights, don't store binaries in git
**/*_openvino_model/
# Scenario snapshot log files
**/Lidar/logs/
ros2_ws/*.log
ros2_ws/*.log.
ros2_ws/bags/
*.bak

# Local patch backups from interactive editing sessions
*.bak
*.bak[0-9]
*.bak_*
ros2_ws/debug_crops/
*.orig

# Reproduction of 10 Oct 2026 (2.0 GB workspace, 1.5 GB results; results already copied into ros2_ws/analysis)
repro_ws/
repro_results/

# A-E re-run workspace (13 Oct 2026): recordings, logs and model copies; the bags are also in ros2_ws/bags
ablation_ws/bags/
ablation_ws/logs/
ablation_ws/simulation_models/

# local archive of unused leftovers (not part of the thesis code)
archive/
# personal development notes (kept locally, not published)
notes/
